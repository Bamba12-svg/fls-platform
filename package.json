{
  "name": "fls-platform",
  "private": true,
  "description": "Plateforme B2B/B2C de Fourniture Libre Service (FLS) – Groupe COSEMAD",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @fls/db generate",
    "db:migrate": "pnpm --filter @fls/db migrate:dev",
    "db:deploy": "pnpm --filter @fls/db migrate:deploy",
    "db:seed": "pnpm --filter @fls/db seed",
    "db:studio": "pnpm --filter @fls/db studio"
  },
  "devDependencies": {
    "turbo": "2.1.3",
    "typescript": "5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild", "sharp", "bcryptjs"]
  }
}
