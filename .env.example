# Base PostgreSQL (Neon en production, Docker en local : voir docker-compose.yml)
DATABASE_URL="postgresql://fls:fls@localhost:5432/fls?schema=public"

# Authentification (générez une valeur : openssl rand -base64 32)
NEXTAUTH_SECRET="changez-moi"
NEXTAUTH_URL="http://localhost:3000"

# URL publique du site (SEO : sitemap, balises canoniques, hreflang)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Back-office : application séparée servie sous /admin-fls via une réécriture du site
ADMIN_URL="http://localhost:3001"

# Médias : dossier local en développement (partagé avec le site) ou Cloudinary en production
MEDIA_DIR="../web/public/uploads"
# CLOUDINARY_URL="cloudinary://<cle>:<secret>@<cloud>"

# Justificatifs clients (NINEA, RCCM, CV) : stockage privé, jamais servi publiquement
PRIVATE_DIR="../../storage/private"

# Secret de session du back-office (différent de NEXTAUTH_SECRET de préférence)
ADMIN_SECRET="changez-moi-aussi"

# Mode démonstration sans base de données (données en mémoire) : DATA_SOURCE=demo
# DATA_SOURCE="demo"
# Afficher les comptes de démonstration sur la page de connexion
# SHOW_DEMO_ACCOUNTS="true"
