{
  "name": "@fls/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc --noEmit",
    "audit:protect": "dotenv -e ../../.env -- prisma db execute --file prisma/sql/audit_immutable.sql --schema prisma/schema.prisma",
    "setup": "dotenv -e ../../.env -- prisma migrate dev --name init && pnpm audit:protect && pnpm seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "@fls/core": "workspace:*"
  },
  "devDependencies": {
    "@fls/config": "workspace:*",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.16.11",
    "prisma": "5.22.0",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "dotenv-cli": "7.4.2"
  }
}